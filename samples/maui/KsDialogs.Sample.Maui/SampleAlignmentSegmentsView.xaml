<?xml version="1.0" encoding="utf-8" ?>
<!-- 配置を3択から選ぶセグメント。 -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:KsDialogs.Sample.Maui"
             x:Class="KsDialogs.Sample.Maui.SampleAlignmentSegmentsView">

    <Border BackgroundColor="{StaticResource SampleSurfaceVariant}"
            StrokeThickness="0"
            Padding="3">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="10" />
        </Border.StrokeShape>

        <HorizontalStackLayout>
            <Button x:Name="StartSegment"
                    Text="{x:Static local:SampleText.AlignmentStart}"
                    FontSize="13"
                    HeightRequest="34"
                    MinimumHeightRequest="0"
                    Padding="12,0"
                    CornerRadius="8"
                    BorderWidth="0"
                    Clicked="OnStartSelected"
                    HandlerChanged="OnSegmentHandlerChanged" />

            <Button x:Name="CenterSegment"
                    Text="{x:Static local:SampleText.AlignmentCenter}"
                    FontSize="13"
                    HeightRequest="34"
                    MinimumHeightRequest="0"
                    Padding="12,0"
                    CornerRadius="8"
                    BorderWidth="0"
                    Clicked="OnCenterSelected"
                    HandlerChanged="OnSegmentHandlerChanged" />

            <Button x:Name="EndSegment"
                    Text="{x:Static local:SampleText.AlignmentEnd}"
                    FontSize="13"
                    HeightRequest="34"
                    MinimumHeightRequest="0"
                    Padding="12,0"
                    CornerRadius="8"
                    BorderWidth="0"
                    Clicked="OnEndSelected"
                    HandlerChanged="OnSegmentHandlerChanged" />
        </HorizontalStackLayout>
    </Border>

</ContentView>
