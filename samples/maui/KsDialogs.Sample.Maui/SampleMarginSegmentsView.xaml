<?xml version="1.0" encoding="utf-8" ?>
<!-- 全辺そろえの余白を3択から選ぶセグメント。配置のセグメントと同じ見た目にする。 -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:KsDialogs.Sample.Maui"
             x:Class="KsDialogs.Sample.Maui.SampleMarginSegmentsView">

    <Border BackgroundColor="{StaticResource SampleSurfaceVariant}"
            StrokeThickness="0"
            Padding="3">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="10" />
        </Border.StrokeShape>

        <HorizontalStackLayout>
            <Button x:Name="ZeroSegment"
                    Text="{x:Static local:SampleText.Margin0}"
                    FontSize="13"
                    HeightRequest="34"
                    MinimumHeightRequest="0"
                    Padding="12,0"
                    CornerRadius="8"
                    BorderWidth="0"
                    Clicked="OnZeroSelected"
                    HandlerChanged="OnSegmentHandlerChanged" />

            <Button x:Name="TwentyFourSegment"
                    Text="{x:Static local:SampleText.Margin24}"
                    FontSize="13"
                    HeightRequest="34"
                    MinimumHeightRequest="0"
                    Padding="12,0"
                    CornerRadius="8"
                    BorderWidth="0"
                    Clicked="OnTwentyFourSelected"
                    HandlerChanged="OnSegmentHandlerChanged" />

            <Button x:Name="FortyEightSegment"
                    Text="{x:Static local:SampleText.Margin48}"
                    FontSize="13"
                    HeightRequest="34"
                    MinimumHeightRequest="0"
                    Padding="12,0"
                    CornerRadius="8"
                    BorderWidth="0"
                    Clicked="OnFortyEightSelected"
                    HandlerChanged="OnSegmentHandlerChanged" />
        </HorizontalStackLayout>
    </Border>

</ContentView>
