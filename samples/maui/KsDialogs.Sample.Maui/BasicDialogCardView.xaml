<?xml version="1.0" encoding="utf-8" ?>
<!--
	Basic Dialog の中身。
	覆い (scrim) と中央配置はライブラリの器が受け持つため、このカード自体だけを描く。
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:KsDialogs.Sample.Maui"
             x:Class="KsDialogs.Sample.Maui.BasicDialogCardView">

    <Border WidthRequest="272"
            BackgroundColor="{StaticResource SampleSurface}"
            StrokeThickness="0"
            Padding="20,24,20,20">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="20" />
        </Border.StrokeShape>

        <VerticalStackLayout Spacing="20">
            <Label x:Name="MessageLabel"
                   FontSize="15"
                   TextColor="{StaticResource SampleOnSurface}"
                   HorizontalTextAlignment="Center" />

            <!-- ボタンの高さは各 OS の推奨タップ領域 (iOS 44pt / Android 48dp) を下限にする -->
            <Grid ColumnDefinitions="*,10,*">
                <Button Text="{x:Static local:SampleText.CancelAction}"
                        FontSize="14"
                        HeightRequest="{OnPlatform iOS=44, Android=48}"
                        MinimumHeightRequest="0"
                        Padding="0"
                        CornerRadius="10"
                        BorderWidth="0"
                        BackgroundColor="{StaticResource SampleSurfaceVariant}"
                        TextColor="{StaticResource SampleOnSurface}"
                        Clicked="OnCancelClicked" />

                <Button Grid.Column="2"
                        Text="{x:Static local:SampleText.CompleteAction}"
                        FontSize="14"
                        FontAttributes="Bold"
                        HeightRequest="{OnPlatform iOS=44, Android=48}"
                        MinimumHeightRequest="0"
                        Padding="0"
                        CornerRadius="10"
                        BorderWidth="0"
                        BackgroundColor="{StaticResource SamplePrimary}"
                        TextColor="{StaticResource SampleOnPrimary}"
                        Clicked="OnCompleteClicked" />
            </Grid>
        </VerticalStackLayout>
    </Border>

</ContentView>
