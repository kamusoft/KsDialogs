<?xml version="1.0" encoding="utf-8" ?>
<!-- 基準領域を3択から選ぶセグメント。配置のセグメントと同じ見た目で、行の幅いっぱいに等分して並べる。 -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:KsDialogs.Sample.Maui"
             x:Class="KsDialogs.Sample.Maui.SampleLayoutAreaSegmentsView">

    <Border BackgroundColor="{StaticResource SampleSurfaceVariant}"
            StrokeThickness="0"
            Padding="3">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="10" />
        </Border.StrokeShape>

        <Grid ColumnDefinitions="*,*,*">
            <Button x:Name="WindowSegment"
                    Text="{x:Static local:SampleText.LayoutAreaWindow}"
                    FontSize="13"
                    HeightRequest="34"
                    MinimumHeightRequest="0"
                    Padding="12,0"
                    CornerRadius="8"
                    BorderWidth="0"
                    LineBreakMode="NoWrap"
                    Clicked="OnWindowSelected"
                    HandlerChanged="OnSegmentHandlerChanged" />

            <Button x:Name="VisibleAreaSegment"
                    Grid.Column="1"
                    Text="{x:Static local:SampleText.LayoutAreaVisibleArea}"
                    FontSize="13"
                    HeightRequest="34"
                    MinimumHeightRequest="0"
                    Padding="12,0"
                    CornerRadius="8"
                    BorderWidth="0"
                    LineBreakMode="NoWrap"
                    Clicked="OnVisibleAreaSelected"
                    HandlerChanged="OnSegmentHandlerChanged" />

            <Button x:Name="CurrentPageSegment"
                    Grid.Column="2"
                    Text="{x:Static local:SampleText.LayoutAreaCurrentPage}"
                    FontSize="13"
                    HeightRequest="34"
                    MinimumHeightRequest="0"
                    Padding="12,0"
                    CornerRadius="8"
                    BorderWidth="0"
                    LineBreakMode="NoWrap"
                    Clicked="OnCurrentPageSelected"
                    HandlerChanged="OnSegmentHandlerChanged" />
        </Grid>
    </Border>

</ContentView>
