<?xml version="1.0" encoding="utf-8" ?>
<!-- タイトルバーを持たないタブ。説明文と、パネルの設定をそのまま使う表示操作を置く。 -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:local="clr-namespace:KsDialogs.Sample.Maui"
             x:Class="KsDialogs.Sample.Maui.SampleLayoutInfoPage"
             ios:Page.UseSafeArea="True"
             Title="{x:Static local:SampleText.InfoTab}"
             IconImageSource="tab_info.png"
             BackgroundColor="{StaticResource SampleSurface}">

    <VerticalStackLayout Padding="16,24,16,16" Spacing="20">
        <Label Text="{x:Static local:SampleText.InfoTabBody}"
               FontSize="14"
               LineHeight="1.3"
               TextColor="{StaticResource SampleOnSurface}" />

        <Button Text="{x:Static local:SampleText.ShowAction}"
                HorizontalOptions="Start"
                FontSize="14"
                FontAttributes="Bold"
                HeightRequest="{OnPlatform iOS=44, Android=48}"
                MinimumHeightRequest="0"
                Padding="18,0"
                CornerRadius="10"
                BorderWidth="0"
                BackgroundColor="{StaticResource SamplePrimary}"
                TextColor="{StaticResource SampleOnPrimary}"
                Clicked="OnShowSelected" />
    </VerticalStackLayout>

</ContentPage>
