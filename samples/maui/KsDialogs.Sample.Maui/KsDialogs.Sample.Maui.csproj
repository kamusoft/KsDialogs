<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- 対象は Sample が動く platform だけ (cross/ADR-0006) -->
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>KsDialogs.Sample.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>KsDialogs Sample</ApplicationTitle>
		<ApplicationId>jp.kamusoft.ksdialogs.samples.maui</ApplicationId>

		<ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- 最低対象 OS は iOS 17 / Android 7.0 (API 24) (cross/ADR-0002) -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">17.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2563EB" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2563EB" BaseSize="128,128" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<!--
		公開 product への参照は facade ひとつだけ。Binding 層は推移参照で付いてくる (cross/ADR-0006)。
	-->
	<ItemGroup>
		<ProjectReference Include="../../../maui/KsDialogs.Maui/KsDialogs.Maui.csproj" />
	</ItemGroup>

	<!--
		互換面 (静的 framework) の更新をネイティブリンクの再実行判定へ届けるための開発用の配線。

		SDK の `_ComputeLinkNativeExecutableInputs` は再リンク判定の入力
		`_LinkNativeExecutableInputs` に静的 framework (`_FrameworkNativeReference`) を含めない。
		そのため互換面の Swift だけを直すと `_LinkNativeExecutable` が最新と判定してスキップし、
		古いネイティブ実行ファイルがそのまま .app へ配備される (ビルドは成功と報告される)。
		ここで互換面の framework の実バイナリ (Mach-O) を入力に足し、中身が変わったときだけ
		再リンクさせる。ディレクトリではなく実バイナリを足すのは、ディレクトリでは常に未ビルド扱いに
		なり毎回再リンクしてしまうため。

		この配線が要るのは、ソースツリーの公開 product を ProjectReference で参照する開発用構成
		(cross/ADR-0006) だけである。パッケージ経由の利用者はパッケージ更新で binding の
		アセンブリ自体が変わるため、SDK の既定の判定で追随する。

		依存する SDK の内部要素 (maui/ADR-0003 の「SDK 内部ターゲットへの依存」の増分):
		  target `_ComputeLinkNativeExecutableInputs`
		  item   `_FrameworkNativeReference` (解決済みの framework 実バイナリ)
		         `_LinkNativeExecutableInputs` (`_LinkNativeExecutable` の Inputs)
	-->
	<Target Name="_AddKsBridgeBinaryToNativeLinkInputs"
			AfterTargets="_ComputeLinkNativeExecutableInputs"
			Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<ItemGroup>
			<_LinkNativeExecutableInputs Include="@(_FrameworkNativeReference)"
					Condition="'%(Filename)' == 'KsDialogsMauiBridge'" />
		</ItemGroup>
	</Target>

</Project>
