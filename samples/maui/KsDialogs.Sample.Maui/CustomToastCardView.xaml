<?xml version="1.0" encoding="utf-8" ?>
<!--
	登録経路のカスタム Toast の中身。
	Toast には覆いが無く、デフォルト View も使わないため、この中身が自分で地を描く。
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:KsDialogs.Sample.Maui"
             x:Class="KsDialogs.Sample.Maui.CustomToastCardView">

    <Border BackgroundColor="{StaticResource SamplePrimary}"
            StrokeThickness="0"
            Padding="18,12">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>

        <HorizontalStackLayout Spacing="10">
            <!-- 一辺と同じ半径の角丸は円になる -->
            <Border WidthRequest="20"
                    HeightRequest="20"
                    BackgroundColor="{StaticResource SampleOnPrimary}"
                    StrokeThickness="0"
                    Padding="0"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Label Text="✓"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{StaticResource SamplePrimary}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <Label x:Name="MessageLabel"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{StaticResource SampleOnPrimary}"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Border>

</ContentView>
