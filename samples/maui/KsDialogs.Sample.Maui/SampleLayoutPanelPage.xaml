<?xml version="1.0" encoding="utf-8" ?>
<!-- レイアウト属性を調整してからダイアログを表示する画面。 -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:local="clr-namespace:KsDialogs.Sample.Maui"
             x:Class="KsDialogs.Sample.Maui.SampleLayoutPanelPage"
             ios:Page.UseSafeArea="True"
             BackgroundColor="{StaticResource SampleSurface}">

    <VerticalStackLayout>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="16,20,16,12">
            <!-- 記号1文字でも押しやすさの下限を満たす領域を確保する。
                 記号のままでは読み上げが操作の意味を伝えないため、名前と役割も与える -->
            <Label Text="‹"
                   FontSize="20"
                   WidthRequest="44"
                   HeightRequest="44"
                   VerticalTextAlignment="Center"
                   SemanticProperties.Description="戻る"
                   Loaded="OnBackLoaded"
                   TextColor="{StaticResource SampleOnSurface}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackSelected" />
                </Label.GestureRecognizers>
            </Label>

            <Label Grid.Column="1"
                   Text="{x:Static local:SampleText.LayoutDialogItem}"
                   FontSize="17"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   TextColor="{StaticResource SampleOnSurface}" />

            <Button Grid.Column="2"
                    Text="{x:Static local:SampleText.ShowAction}"
                    FontSize="14"
                    FontAttributes="Bold"
                    HeightRequest="{OnPlatform iOS=44, Android=48}"
                    MinimumHeightRequest="0"
                    Padding="18,0"
                    CornerRadius="10"
                    BorderWidth="0"
                    BackgroundColor="{StaticResource SamplePrimary}"
                    TextColor="{StaticResource SampleOnPrimary}"
                    Clicked="OnShowSelected" />
        </Grid>

        <BoxView HeightRequest="1" Color="{StaticResource SampleDivider}" />

        <!-- 調整用の行も押しやすさの下限を満たす高さを確保する -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="16,6" MinimumHeightRequest="48">
            <Label Text="{x:Static local:SampleText.HorizontalLabel}"
                   FontSize="14"
                   VerticalOptions="Center"
                   TextColor="{StaticResource SampleOnSurface}" />
            <local:SampleAlignmentSegmentsView x:Name="HorizontalSegments"
                                               Grid.Column="1"
                                               AxisLabel="{x:Static local:SampleText.HorizontalLabel}"
                                               VerticalOptions="Center" />
        </Grid>

        <BoxView HeightRequest="1" Color="{StaticResource SampleDivider}" />

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="16,6" MinimumHeightRequest="48">
            <Label Text="{x:Static local:SampleText.VerticalLabel}"
                   FontSize="14"
                   VerticalOptions="Center"
                   TextColor="{StaticResource SampleOnSurface}" />
            <local:SampleAlignmentSegmentsView x:Name="VerticalSegments"
                                               Grid.Column="1"
                                               AxisLabel="{x:Static local:SampleText.VerticalLabel}"
                                               VerticalOptions="Center" />
        </Grid>

        <BoxView HeightRequest="1" Color="{StaticResource SampleDivider}" />

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="16,6" MinimumHeightRequest="48">
            <Label Text="{x:Static local:SampleText.OffsetXLabel}"
                   FontSize="14"
                   VerticalOptions="Center"
                   TextColor="{StaticResource SampleOnSurface}" />
            <Border Grid.Column="1"
                    WidthRequest="64"
                    HeightRequest="36"
                    Padding="10,0"
                    Stroke="{StaticResource SampleDivider}"
                    StrokeThickness="1"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Entry x:Name="OffsetXEntry"
                       Text="0"
                       SemanticProperties.Description="{x:Static local:SampleText.OffsetXLabel}"
                       HandlerChanged="OnOffsetEntryHandlerChanged"
                       FontSize="14"
                       FontFamily="{OnPlatform iOS=Menlo, Android=monospace}"
                       HorizontalTextAlignment="End"
                       VerticalOptions="Center"
                       TextColor="{StaticResource SampleOnSurface}" />
            </Border>
        </Grid>

        <BoxView HeightRequest="1" Color="{StaticResource SampleDivider}" />

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="16,6" MinimumHeightRequest="48">
            <Label Text="{x:Static local:SampleText.OffsetYLabel}"
                   FontSize="14"
                   VerticalOptions="Center"
                   TextColor="{StaticResource SampleOnSurface}" />
            <Border Grid.Column="1"
                    WidthRequest="64"
                    HeightRequest="36"
                    Padding="10,0"
                    Stroke="{StaticResource SampleDivider}"
                    StrokeThickness="1"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Entry x:Name="OffsetYEntry"
                       Text="0"
                       SemanticProperties.Description="{x:Static local:SampleText.OffsetYLabel}"
                       HandlerChanged="OnOffsetEntryHandlerChanged"
                       FontSize="14"
                       FontFamily="{OnPlatform iOS=Menlo, Android=monospace}"
                       HorizontalTextAlignment="End"
                       VerticalOptions="Center"
                       TextColor="{StaticResource SampleOnSurface}" />
            </Border>
        </Grid>

        <BoxView HeightRequest="1" Color="{StaticResource SampleDivider}" />

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="16,6" MinimumHeightRequest="48">
            <Label Text="{x:Static local:SampleText.UseVisibleAreaLabel}"
                   FontSize="14"
                   VerticalOptions="Center"
                   TextColor="{StaticResource SampleOnSurface}" />
            <Switch x:Name="VisibleAreaSwitch"
                    Grid.Column="1"
                    IsToggled="True"
                    SemanticProperties.Description="{x:Static local:SampleText.UseVisibleAreaLabel}"
                    VerticalOptions="Center"
                    HandlerChanged="OnVisibleAreaSwitchHandlerChanged"
                    OnColor="{StaticResource SamplePrimary}"
                    ThumbColor="{StaticResource SampleSurface}" />
        </Grid>

        <BoxView HeightRequest="1" Color="{StaticResource SampleDivider}" />

        <!-- 一度もダイアログを閉じていない間は表示するものがない -->
        <VerticalStackLayout x:Name="ResultArea"
                             IsVisible="False"
                             BackgroundColor="{StaticResource SampleSurfaceVariant}"
                             Padding="16,14"
                             Spacing="4">
            <Label Text="{x:Static local:SampleText.ResultCaption}"
                   FontSize="12"
                   TextColor="{StaticResource SampleOnSurfaceMuted}" />
            <Label x:Name="ResultValueLabel"
                   FontSize="14"
                   FontFamily="{OnPlatform iOS=Menlo, Android=monospace}"
                   TextColor="{StaticResource SampleOnSurface}" />
        </VerticalStackLayout>
    </VerticalStackLayout>

</ContentPage>
