<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-ios;net10.0-android</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- namespace と NuGet ID は公開識別子の写像表 (cross/ADR-0005) に従う -->
    <RootNamespace>KsDialogs</RootNamespace>
    <PackageId>KsDialogs.Maui</PackageId>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- 最低対象 OS は iOS 17 / Android 7.0 (API 24) (cross/ADR-0002) -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.1" />
  </ItemGroup>

  <!-- 委譲面の実体を持つのは platform TFM だけ (maui/ADR-0002) -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <ProjectReference Include="../macios/KsDialogs.Binding.iOS/KsDialogs.Binding.iOS.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <ProjectReference Include="../android/KsDialogs.Binding.Android/KsDialogs.Binding.Android.csproj" />
  </ItemGroup>

  <!-- 非公開の型をテストアセンブリからのみ参照できるようにする -->
  <ItemGroup>
    <InternalsVisibleTo Include="KsDialogs.Maui.Tests" />
  </ItemGroup>

</Project>
