<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-ios;net10.0-android</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>KsDialogs</RootNamespace>
  </PropertyGroup>

  <!--
    NuGet パッケージとしての公開面 (facade + 輸送層 binding 2 件の 3 パッケージ構成、maui/ADR-0004)。
    Package ID と namespace は公開識別子の写像表
    (cross/ADR-0005) に従い、ID は KsDialogs.Maui・namespace は KsDialogs で非対称になる。
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>KsDialogs.Maui</PackageId>
    <Description>A dialog UI library for .NET MAUI that presents dialogs, loading indicators, and toasts from anywhere in an application, with content written as MAUI views, on iOS and Android. Successor to AiForms.Maui.Dialogs.</Description>
    <PackageTags>maui dialog dialogs loading toast ios android</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!--
      公開面の doc コメントを XML ドキュメントとして 3 TFM ぶん生成し、nupkg の lib/<TFM>/ へ
      同梱する。利用者の IDE で説明が読めるのはこのファイルによる。
      指定は共通の props ではなくここに置く — XML ドキュメントを持つのは利用者向けの公開契約を
      持つ facade だけで、輸送層 binding 2 件は false を自分の csproj で宣言する。
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- package README はこのパッケージ固有のため、共通の props ではなくここで同梱する -->
    <None Include="../../README.md" Pack="true" PackagePath="" Visible="false" />
    <!-- 最低 OS 版の検査を利用者のビルドへ届ける。定数の props と検査の targets を対で同梱する -->
    <None Include="buildTransitive/KsDialogs.Maui.props" Pack="true" PackagePath="buildTransitive/" />
    <None Include="buildTransitive/KsDialogs.Maui.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

  <!-- 最低対象 OS の要件は buildTransitive の props が宣言元 (cross/ADR-0002) -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <SupportedOSPlatformVersion>$(KsDialogsMinIOSVersion)</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <SupportedOSPlatformVersion>$(KsDialogsMinAndroidApi)</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <!-- 委譲面の実体を持つのは platform TFM だけ (maui/ADR-0002) -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <ProjectReference Include="../macios/KsDialogs.Binding.iOS/KsDialogs.Binding.iOS.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <ProjectReference Include="../android/KsDialogs.Binding.Android/KsDialogs.Binding.Android.csproj" />
  </ItemGroup>

  <!-- 非公開の型をテストアセンブリからのみ参照できるようにする -->
  <ItemGroup>
    <InternalsVisibleTo Include="KsDialogs.Maui.Tests" />
  </ItemGroup>

</Project>
