<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KsDialogs.Maui\KsDialogs.Maui.csproj" />
    <!--
      公開 API 形状の検証プロジェクト。参照するのは dotnet test で必ずビルドさせるためで、
      このプロジェクトから検証の中身を呼ぶわけではない (コンパイルできること自体が検証結果)。
      検証側は InternalsVisibleTo を持たないため、利用者と同じ可視性のまま保たれる
    -->
    <ProjectReference Include="..\KsDialogs.Maui.ApiSurfaceCheck\KsDialogs.Maui.ApiSurfaceCheck.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

</Project>
