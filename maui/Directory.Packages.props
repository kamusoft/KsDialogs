<Project>

  <!--
    maui/ ビルドルート配下の PackageReference の版はここが単一の宣言元 (cross/ADR-0018)。各 csproj は Version を持たない。
    samples/maui は別のビルドルートであり、利用者が真似する形 (MauiVersion の直書き) を保つため対象外。
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!--
      MAUI 本体。この版が利用者に求める下限で、ライブラリをビルド・テストする版でもある (maui/ADR-0004)。
      repo 直下の global.json が固定する workload set を上げても、この版は同梱版 ($(MauiVersion) の既定値)
      へ合わせず据え置く。上げると、古い workload set の利用者が版を明記しない限り復元で止まる (NU1605)。
      この版で workload set のビルド・テストが通らないときは、上げる前にオーナーの判断を仰ぐ (maui/ADR-0007)。
    -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.20" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Android 本体が Gradle 側で implementation 依存として宣言しているライブラリ。
      aar には同梱されないため、消費側アプリへ届くよう binding の依存として並べる。
    -->
    <PackageVersion Include="Xamarin.Kotlin.StdLib" Version="2.4.0.1" />
    <PackageVersion Include="Xamarin.KotlinX.Coroutines.Android" Version="1.11.0.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

</Project>
